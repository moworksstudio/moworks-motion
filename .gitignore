!/brands/README.md
# the studio's own reference films / images
/library/refs/video/*
!/library/refs/video/README.md
/library/refs/image/*
!/library/refs/image/README.md
# AI models: install.bat / update.bat download them (engine/models.json)
/engine/models/*
!/engine/models/README.md

# machine and sync files
__pycache__/
*.pyc
desktop.ini
Thumbs.db
~$*
.tmp.drivedownload/
.tmp.driveupload/
*.part
